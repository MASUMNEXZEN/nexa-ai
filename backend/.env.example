# Copy this file to backend/.env for local development.
# Never commit backend/.env or use production credentials locally.

# Primary and optional AI providers
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
BEDROCK_PROXY_URL=
BEDROCK_PROXY_SECRET=
TELEGRAM_GEMINI_MODEL=gemini-2.0-flash

# Authentication and payments
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD_HASH=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Integrations
TELEGRAM_BOT_TOKEN=
# FCM service-account JSON belongs at backend/data/fcm-key.json and is never committed.

# Local runtime defaults
NEXA_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
NEXA_TRUST_PROXY_HEADERS=0
NEXA_COOKIE_SECURE=0
NEXA_APP_ENV=local
NEXA_MAIL_TRANSPORT=log
